# Configuração do RabbitMQ para o projeto service_flow
# Este arquivo é carregado automaticamente pelo setup.sh

# Usuário da aplicação no RabbitMQ
RABBITMQ_USER=service_flow_user
RABBITMQ_PASS=change_me_in_production

# Tags do usuário (ex: administrator, management, monitoring, none)
RABBITMQ_TAGS=management

# Virtual host dedicado ao projeto
RABBITMQ_VHOST=/service_flow

# Permissões no vhost (regexes padrão: .* = tudo)
RABBITMQ_PERM_CONFIGURE=.*
RABBITMQ_PERM_READ=.*
RABBITMQ_PERM_WRITE=.*
