# ============================================
# Configuração do RabbitMQ - TEMPLATE
# ============================================
# Copie este arquivo para: projects/seu_projeto/config.env
# Edite os valores e remova as credenciais de exemplo
# ============================================

# Usuário da aplicação no RabbitMQ
RABBITMQ_USER=seu_projeto

# Senha do usuário (gere uma segura: openssl rand -base64 32)
RABBITMQ_PASS=SUA_SENHA_SEGURA_AQUI

# Tags do usuário (administrator, management, monitoring, policymaker, none)
# "management" permite acesso à UI de gerenciamento
RABBITMQ_TAGS=management

# Virtual host dedicado ao projeto (deve começar com /)
RABBITMQ_VHOST=/seu_projeto

# Permissões no vhost (regexes: .* = tudo)
# Configure: quais exchanges/queues pode declarar
# Read: quais queues pode consumir
# Write: quais exchanges pode publicar
RABBITMQ_PERM_CONFIGURE=.*
RABBITMQ_PERM_READ=.*
RABBITMQ_PERM_WRITE=.*